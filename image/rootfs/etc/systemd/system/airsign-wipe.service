[Unit]
Description=airsign: erase this computer's internal drives (wipe boot entry only)
After=systemd-udevd.service usbguard.service
ConditionKernelCommandLine=airsign.wipe=1

[Service]
Type=oneshot
ExecStart=/usr/local/lib/airsign/wipe-disks.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes

[Install]
WantedBy=multi-user.target
