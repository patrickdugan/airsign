[Unit]
Description=airsign: refuse to run unless booted into RAM; block USB storage
DefaultDependencies=no
After=local-fs.target systemd-udevd.service
Before=usbguard.service airsign.service airsign-selftest.service
ConditionKernelCommandLine=!airsign.wipe=1

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/airsign/lockdown.sh

[Install]
WantedBy=multi-user.target
